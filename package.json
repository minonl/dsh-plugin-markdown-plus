{
  "name": "@minonl/dsh-plugin-markdown-plus",
  "version": "0.0.1",
  "type": "module",
  "description": "Markdown+ for DeepSeek Harness — enhanced Markdown preview with Mermaid rendering and graceful fallback",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "mermaid"
  ],
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": []
    }
  },
  "scripts": {
    "build": "bun run scripts/build.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/preload.ts",
    "prepublishOnly": "bun run build && bun test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/bun": "latest",
    "happy-dom": "^21.0.3",
    "mermaid": "12.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
