{
  "name": "@minonl/dsh-plugin-markdown-plus",
  "version": "0.1.0-beta.0",
  "description": "One-stop Markdown enhancement for DeepSeek Harness Web: Mermaid diagrams with visible degradation, more to come.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "mermaid",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minonl/dsh-plugin-markdown-plus.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": []
    }
  },
  "scripts": {
    "build": "bun run scripts/build.mjs",
    "dev": "vite --config dev/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/preload.ts",
    "prepublishOnly": "bun run build && bun run test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/bun": "latest",
    "happy-dom": "^21.0.3",
    "mermaid": "12.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
